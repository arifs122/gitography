{
  "name": "gitography",
  "version": "0.1.0",
  "description": "Spotify Wrapped for your Git repository. A zero-dependency CLI that turns any repo's history into a beautiful, self-contained interactive HTML report.",
  "type": "module",
  "bin": {
    "gitography": "bin/gitography.js"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "test": "node --test",
    "test:watch": "node --test --watch",
    "demo": "node bin/gitography.js .",
    "check": "node --check bin/gitography.js && node --check src/cli.js"
  },
  "keywords": [
    "git",
    "analytics",
    "report",
    "visualization",
    "statistics",
    "cli",
    "html",
    "wrapped",
    "developers",
    "contributors",
    "heatmap",
    "zero-dependency"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arifs122/gitography.git"
  },
  "bugs": {
    "url": "https://github.com/arifs122/gitography/issues"
  },
  "homepage": "https://github.com/arifs122/gitography#readme",
  "author": "arifs122"
}
